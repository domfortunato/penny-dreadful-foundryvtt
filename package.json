{
  "name": "penny-dreadful",
  "version": "0.1.0",
  "description": "Penny Dreadful for Foundry VTT: flip your pennies.",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js ./module --format node_modules/eslint-plugin-i18n-json/formatter.js lang/*",
    "lint:fix": "eslint --fix --ext .js ./module --format node_modules/eslint-plugin-i18n-json/formatter.js lang/*",
    "check:syntax": "node tools/dev/syntax-check.mjs",
    "check:manifest": "node tools/dev/manifest-check.mjs",
    "check:i18n": "node tools/dev/i18n-check.mjs",
    "check": "npm run check:syntax && npm run check:manifest && npm run check:i18n && npm run lint",
    "build:packs": "node tools/packs.mjs build",
    "extract:packs": "node tools/packs.mjs extract",
    "import:rules": "node tools/import/rules.mjs && node tools/import/odds.mjs",
    "import:odds": "node tools/import/odds.mjs",
    "release": "node tools/release.mjs",
    "dev:smoke": "node tools/dev/e2e-smoke.mjs",
    "dev:smoke-module": "node tools/dev/e2e-smoke-module.mjs",
    "dev:detach": "node tools/dev/e2e-detach.mjs"
  },
  "author": "Dom Bosco (https://github.com/domfortunato)",
  "license": "MIT",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "eslint": "^8.25.0",
    "eslint-plugin-i18n-json": "^4.0.0",
    "eslint-plugin-import": "^2.26.0",
    "js-yaml": "^5.2.1",
    "marked": "^18.0.9"
  }
}
